    { "type": "object_state_changed", "group": "state", "payload": { "objectId": "object", "state": "string" } },
    { "type": "dark_line_changed", "group": "truth", "payload": { "darkLineId": "darkLine", "state": "darkLineState" } },
    { "type": "truth_evidence_added", "group": "truth", "payload": { "darkLineId": "darkLine", "evidenceId": "string", "reliable": "bool" } },
    { "type": "truth_verified", "group": "truth", "payload": { "truthId": "truth", "layer": "int" } },
    { "type": "historical_record_verified", "group": "truth", "payload": { "recordId": "string", "kind": "suppressed|forged|lost" } },
    { "type": "historical_falsehood_corrected", "group": "truth", "payload": { "historicalPeriod": "string" } },
    { "type": "memory_fragment_verified", "group": "truth", "payload": { "fragmentId": "string" } },
    { "type": "npc_met", "group": "npc", "payload": { "npcId": "npc" } },
    { "type": "npc_state_changed", "group": "npc", "payload": { "npcId": "npc", "state": "npcState" } },
    { "type": "npc_attitude_changed", "group": "npc", "payload": { "npcId": "npc", "towardsId": "npc|party", "delta": "int", "value": "int" } },
    { "type": "npc_impression_added", "group": "npc", "payload": { "npcId": "npc", "text": "string", "milestone": "bool" } },
    { "type": "npc_learned", "group": "npc", "payload": { "npcId": "npc", "factId": "fact", "via": "witnessed|told|rumor", "fromId": "string", "arrivesAtRound": "int" } },
    { "type": "npc_belief_changed", "group": "npc", "payload": { "npcId": "npc", "beliefId": "string", "position": "string", "evidenceEventIds": "string[]" } },
    { "type": "npc_trust_earned", "group": "npc", "payload": { "npcId": "npc" } },
    { "type": "npc_rescued", "group": "npc", "payload": { "subjectId": "npc" } },
    { "type": "npc_name_restored", "group": "npc", "payload": { "npcId": "npc" } },
    { "type": "npc_oath_kept", "group": "npc", "payload": { "npcId": "npc", "oathId": "string" } },
    { "type": "npc_reconciled", "group": "npc", "payload": { "npcId": "npc", "priorRelation": "hostile|rival" } },
    { "type": "npc_help_from_former_enemy", "group": "npc", "payload": { "npcId": "npc" } },
    { "type": "npc_relationship_repaired", "group": "npc", "payload": { "npcId": "npc" } },
    { "type": "npc_arc_resolved", "group": "npc", "payload": { "npcId": "npc" } },
    { "type": "personal_farewell_kept", "group": "npc", "payload": { "npcId": "npc" } },
    { "type": "hunger_changed", "group": "nameless", "payload": { "delta": "int", "value": "int", "cause": "call|read|rest|clock|other" } },
    { "type": "name_invoked", "group": "nameless", "payload": { "nameId": "string", "mode": "call|read|rest" } },
    { "type": "bell_city_verified", "group": "bells", "payload": { "cityId": "bellCity" } },
    { "type": "bell_heart_moved", "group": "bells", "payload": { "bellHeartId": "bellCity", "holder": "party|faction|origin|destroyed", "holderId": "string" } },
    { "type": "bell_heart_disposition_verified", "group": "bells", "payload": { "bellHeartId": "bellCity", "disposition": "string" } },
    { "type": "bell_ring_prevented", "group": "bells", "payload": { "irreversible": "bool" } },
    { "type": "door_outcome_committed", "group": "bells", "payload": { "outcome": "doorOutcome", "votes": "string[]", "tieRoll": "int" } },
    { "type": "interaction_completed", "group": "interaction", "payload": { "template": "interaction", "outcome": "completed|skipped|failed", "textId": "string", "interactionInstanceId": "string" } },
    { "type": "direction_weight_changed", "group": "ending", "payload": { "directionId": "direction", "delta": "int", "value": "int" } },
    { "type": "ending_committed", "group": "ending", "payload": { "directionId": "direction", "secondaryDirectionId": "direction", "variant": "wander|settle|none", "worldResolution": "resolved|unresolved" } },
    { "type": "legend_recognized", "group": "ending", "payload": { "legendId": "string" } },
    { "type": "nonviolent_crisis_resolved", "group": "ending", "payload": { "severity": "low|medium|high" } },
    { "type": "custom_resolution_verified", "group": "ending", "payload": { "importance": "minor|major|world" } },
    { "type": "player_project_created", "group": "sandbox", "payload": { "projectId": "string", "kind": "tavern|guild|caravan|sanctuary|home|custom", "regionId": "region" } },
    { "type": "player_project_stage_changed", "group": "sandbox", "payload": { "projectId": "string", "stage": "idea|founded|operational|stable|closed" } },
    { "type": "player_project_details", "group": "sandbox", "payload": { "projectId": "string", "name": "string", "contactId": "npc" } },
    { "type": "player_project_risk", "group": "sandbox", "payload": { "projectId": "string", "risk": "tax|seal|brawl|patients|other", "weathered": "bool" } },
    { "type": "tavern_service_settled", "group": "sandbox", "payload": { "projectId": "string", "revenue": "int", "cost": "int" } },
    { "type": "business_operational", "group": "sandbox", "payload": { "projectId": "string", "kind": "string", "regionId": "region" } },
    { "type": "business_profitable", "group": "sandbox", "payload": { "projectId": "string", "sustained": "bool" } },
    { "type": "trade_route_established", "group": "sandbox", "payload": { "projectId": "string", "stable": "bool" } },
    { "type": "civic_service_operational", "group": "sandbox", "payload": { "projectId": "string", "kind": "shelter|clinic|school|other" } },
    { "type": "player_organization_created", "group": "sandbox", "payload": { "projectId": "string", "independent": "bool" } },
    { "type": "home_established", "group": "sandbox", "payload": { "regionId": "region", "persistent": "bool" } }
  ]
}
