{
  "version": 1,
  "about": "伊瑟兰第一章的事件词表。每个事件按设计包 contracts/narrative.types.ts 的 CanonicalEvent 外壳提交（eventId、runId、seq、type、actorIds、regionId、subjectId、payload、sourceIntentId、committedAt、visibility），这里只定义 type 与 payload 字段。字段值里的编号必须来自 vocab.v1.json。规则见 12-开工规格.md 第 4 节。",
  "fieldTypes": {
    "regionId": "region", "placeId": "place", "npcId": "npc", "subjectId": "npc", "towardsId": "npc", "factionId": "faction", "towardsFactionId": "faction",
    "arcId": "arc", "directionId": "direction", "secondaryDirectionId": "direction", "darkLineId": "darkLine", "truthId": "truth",
    "cityId": "bellCity", "bellHeartId": "bellCity", "factId": "fact", "objectId": "object", "template": "interaction"
  },
  "events": [
    { "type": "run_started", "group": "run", "payload": { "mode": "solo|online", "partySize": "int", "seed": "string", "openingHook": "openingHook" } },
    { "type": "round_started", "group": "run", "payload": { "round": "int" } },
    { "type": "seat_changed", "group": "run", "payload": { "seatId": "string", "actorId": "string", "controller": "human|ai|empty", "inheritedChoices": "int" } },
    { "type": "choice_counted", "group": "run", "payload": { "seatId": "string", "actorId": "string", "changeKinds": "string[]", "dedupeKey": "string" } },
    { "type": "consent_given", "group": "run", "payload": { "actorId": "string", "consequence": "death|memory_loss|stay_behind|other", "detail": "string" } },
    { "type": "act_entered", "group": "story", "payload": { "act": "int", "via": "progress|wrap_up|door" } },
    { "type": "first_hook_taken", "group": "story", "payload": { "regionId": "region", "hookId": "string" } },
    { "type": "arc_beat_reached", "group": "story", "payload": { "arcId": "arc", "beat": "beat" } },
    { "type": "core_arc_resolved", "group": "story", "payload": { "arcId": "arc", "outcomes": "outcome[]" } },
    { "type": "text_shown", "group": "story", "payload": { "textId": "string", "round": "int", "count": "int", "rewrittenLines": "int[]" } },
    { "type": "clock_advanced", "group": "world", "payload": { "from": "int", "to": "int", "cause": "faction_plan|world_event|crisis", "planId": "string" } },
    { "type": "clock_reversed", "group": "world", "payload": { "from": "int", "to": "int", "cause": "string" } },
    { "type": "world_crisis_started", "group": "world", "payload": {} },
    { "type": "crisis_escalated", "group": "world", "payload": { "step": "int", "textId": "string" } },
    { "type": "faction_plan_advanced", "group": "world", "payload": { "factionId": "faction", "planId": "string", "stage": "int" } },
    { "type": "faction_plan_blocked", "group": "world", "payload": { "factionId": "faction", "planId": "string", "failedPreconditions": "string[]" } },
    { "type": "faction_state_changed", "group": "world", "payload": { "factionId": "faction", "state": "factionState" } },
    { "type": "faction_relation_changed", "group": "world", "payload": { "factionId": "faction", "towardsFactionId": "faction|party", "delta": "int", "value": "int" } },
    { "type": "faction_contacted", "group": "world", "payload": { "factionId": "faction" } },
    { "type": "faction_treaty_signed", "group": "world", "payload": { "treatyId": "string", "factionIds": "faction[]" } },
    { "type": "region_stage_changed", "group": "world", "payload": { "regionId": "region", "stage": "calm|unrest|converging|resolved", "defaultOutcome": "string" } },
    { "type": "region_crisis_stabilized", "group": "world", "payload": { "regionId": "region" } },
    { "type": "region_visited", "group": "explore", "payload": { "regionId": "region", "isOutsideStart": "bool", "visitIndex": "int" } },
    { "type": "location_changed", "group": "explore", "payload": { "regionId": "region", "placeId": "place|none" } },
    { "type": "ambience_changed", "group": "explore", "payload": { "time": "黎明|白天|黄昏|夜", "weather": "雨|雪|雾|风暴|晴" } },
    { "type": "place_discovered", "group": "explore", "payload": { "placeId": "place", "regionId": "region", "aiCreated": "bool" } },
    { "type": "route_discovered", "group": "explore", "payload": { "routeId": "string", "previouslyUnknown": "bool" } },
